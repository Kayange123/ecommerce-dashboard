    "date-fns": "^4.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "lucide-react": "^1.46.0",
    "next": "^16.4.0",
    "next-cloudinary": "^6.19.0",
    "postcss": "8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
    "stripe": "^13.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "^1.0.7",
