# ─────────────────────────────────────────────────────────────────────────
# Database (MongoDB via Prisma)
# ─────────────────────────────────────────────────────────────────────────
# For local development with the provided docker-compose.yml, this connects
# to the single-node replica set started by `docker compose up -d` (Prisma
# requires a replica set for transactions/nested writes, even locally).
# For production, use a MongoDB Atlas connection string instead.
DATABASE_URL="mongodb://localhost:27017/ecommerce-dashboard?replicaSet=rs0&directConnection=true"

# ─────────────────────────────────────────────────────────────────────────
# Clerk (authentication) — required, no local fallback exists.
# Create a free application at https://dashboard.clerk.com to get these.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# After you sign in once in the running app, copy your Clerk user id (visible
# in the Clerk dashboard under Users, or logged by the app) into this variable
# so `npm run db:seed` can attach the demo stores/products/orders to YOUR
# account. Stores are owned by a single Clerk user id — seeded data is
# unreachable until this is set to a real, existing user id.
SEED_CLERK_USER_ID=

# ─────────────────────────────────────────────────────────────────────────
# Cloudinary (product/billboard image uploads) — required, no local fallback.
# Create a free account at https://cloudinary.com to get this.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─────────────────────────────────────────────────────────────────────────
# Stripe (checkout + webhook) — required for the storefront checkout flow.
# Test-mode keys from https://dashboard.stripe.com/test/apikeys work fine.
# STRIPE_WEB_HOOK_SECRET comes from `stripe listen --print-secret` when
# forwarding webhooks to your local server, or from a configured endpoint.
# ─────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEB_HOOK_SECRET=

# Origin of the separate storefront app that calls the checkout API and
# receives Stripe's success/cancel redirects. Point this at your storefront
# during local development (e.g. http://localhost:3001).
NEXT_PUBLIC_STORE_URL=http://localhost:3001
